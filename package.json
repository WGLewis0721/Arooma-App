{
  "name": "arooma-app",
  "version": "0.1.0",
  "private": true,
  "description": "Arooma: iOS web app demo, a personal cabinet for a fragrance collection.",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "assets": "python3 tools/generate_assets.py",
    "test": "node tests/smoke.cjs .",
    "docs:tokens": "node scripts/design-tokens.mjs --write",
    "docs:sync": "node scripts/design-docs.mjs --sync",
    "docs:check": "node scripts/design-docs.mjs",
    "test:docs": "node --test scripts/design-docs.test.mjs",
    "check": "npm run docs:check && npm run test:docs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
